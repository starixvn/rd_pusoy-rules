{
    "coverageReporters": ["clover", "lcov", "text-summary", "cobertura"],
    "reporters": [
        [
            "jest-html-reporters",
            {
                "pageTitle": "Integration Test Report",
                "publicPath": "./reports",
                "filename": "integration-tests-report.html",
                "openReport": false,
                "inlineSource": true,
                "includeConsoleLog": true
            }
        ],
        ["jest-junit", { "outputDirectory": "coverage", "outputName": "integration-tests.xml" }]
    ]
}
