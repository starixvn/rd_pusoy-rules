{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["es6", "ES2016", "ES2017.Object"],
        "module": "commonjs",
        "rootDir": "src",
        "outDir": "./dist",
        "esModuleInterop": true,
        "strict": true,
        "noImplicitAny": true,
        "declaration": true
    },
    "include": ["src/**/*", "tests"],
    "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"]
}
