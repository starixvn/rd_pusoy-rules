{
    "coverageReporters": ["clover", "lcov", "text-summary", "cobertura"],
    "resetMocks": true,
    "reporters": [
        [
            "jest-html-reporters",
            {
                "pageTitle": "Integration Test Report",
                "publicPath": "./reports",
                "filename": "unit-tests-report.html",
                "openReport": false,
                "inlineSource": true,
                "includeConsoleLog": true
            }
        ],
        [
            "jest-junit",
            { "outputDirectory": "coverage", "outputName": "unit-tests.xml" }
        ]
    ]
}
